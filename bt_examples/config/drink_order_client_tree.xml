<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="DrinkOrderClient">
  <BehaviorTree ID="DrinkOrderClient">
    <Sequence name="DrinkOrderClientSequence">
      <SayTextClient text="¿Qué quieres beber?"/>
      <ListenTextClient recognized_text="{order}"/>
      <ExtractInfoClient interest="bebida"
                         full_text="{order}"
                         extracted_info="{drink_order}"/>
      <SayTextClient text="Has dicho que quieres {drink_order}. Perfecto."/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ExtractInfoClient"
            editable="true">
      <input_port name="interest"/>
      <input_port name="full_text"/>
      <output_port name="extracted_info"/>
    </Action>
    <Action ID="ListenTextClient"
            editable="true">
      <output_port name="recognized_text"/>
    </Action>
    <Action ID="SayTextClient"
            editable="true">
      <input_port name="text"/>
    </Action>
  </TreeNodesModel>

</root>
